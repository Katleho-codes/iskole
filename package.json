{
  "name": "iskole",
  "private": true,
  "version": "0.1.0",
  "description": "iskole: from what do I study to funded, accepted and on track. FNB App of the Year 2026.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @iskole/api dev",
    "dev:web": "pnpm --filter @iskole/web dev",
    "dev:db": "docker compose up -d",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
