// iskole-owned tables grouped below; one section per migration.
// Sample/seed data is always labelled and never read as learner data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// better-auth tables (generated by the better-auth CLI: pnpm dlx @better-auth/cli@latest generate --adapter prisma --dialect postgresql)
// (docs: https://better-auth.com/docs/concepts/cli, https://better-auth.com/docs/adapters/prisma)
// Do not hand-write those tables. Regenerate after changing the auth config.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("STUDENT")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  securityEvents SecurityEvent[]
  auditLogs     AuditLog[]
  profile       Profile?
  companyProfile CompanyProfile?
  guardianConsent GuardianConsent?
  preferences   Preference?
  subjectMarks  SubjectMark[]
  applications  Application[]
  idempotencyKeys IdempotencyKey[]
  expenses      Expense[]
  budgets       Budget[]
  studyPlans    StudyPlan[]
  bookings      Booking[]
  messages      Message[]
  reports       Report[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  route     String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("securityEvent")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@map("auditLog")
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String
  userId       String?
  requestHash  String
  status       Int
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotencyKey")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String?
  phone     String?
  province  String?
  qualificationStatus String?
  grade     Int?
  schoolQualification String?
  interests String?
  /// POPIA age gate: the date of birth is collected before applying or opting in to company
  /// visibility. Stored as a date, not a derived age, because age changes over time.
  dateOfBirth DateTime?
  consentedAt DateTime?
  /// POPIA: off by default. A learner turns this on explicitly before companies can see them.
  talentVisible Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile")
}

/// Company accounts are created by an administrator (there is no public company sign-up).
/// Approval is a separate row rather than a flag on User so the auth table stays generated
/// and a role change alone can never open learner data to a company.
model CompanyProfile {
  userId           String    @id
  organisationName String?
  approved         Boolean   @default(false)
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companyProfile")
}

/// Guardian consent for 16- and 17-year-olds. POPIA: a competent person must consent before
/// a minor's application is opened or submitted. Company visibility is disabled for minors
/// outright.
model GuardianConsent {
  userId          String   @id
  guardianName    String
  guardianContact String
  confirmedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("guardianConsent")
}

model Preference {
  id        String   @id @default(cuid())
  userId    String   @unique
  fields    String[]
  provinces String[]
  budgetCeiling Int?
  studyMode String?
  language  String   @default("en")
  lowDataMode Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preference")
}

model SubjectMark {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  mark      Int
  isHomeLanguage Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject])
  @@index([userId])
  @@map("subjectMark")
}

model Institution {
  id        String   @id @default(cuid())
  name      String   @unique
  province  String
  type      String
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]

  @@map("institution")
}

model Course {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  faculty       String?
  field         String
  qualification String?
  duration      String?
  apsMin        Int      @default(0)
  tuitionMin    Int?
  tuitionMax    Int?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  requirements  CourseRequirement[]
  applications  Application[]

  @@index([field])
  @@index([institutionId])
  @@map("course")
}

model CourseRequirement {
  id         String  @id @default(cuid())
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject    String
  minMark    Int     @default(50)
  isRequired Boolean @default(true)

  @@index([courseId])
  @@map("courseRequirement")
}

model Application {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      String   @default("DRAFT")
  idNumberEnc String?
  idNumberIv  String?
  idNumberTag String?
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      ApplicationEvent[]
  documents   Document[]
  offerLetter OfferLetter?

  @@unique([userId, courseId])
  @@index([userId, status])
  @@map("application")
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        String
  note          String?
  actorId       String?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@map("applicationEvent")
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  size          Int
  key           String
  uploadedAt    DateTime    @default(now())

  @@index([applicationId])
  @@map("document")
}

model OfferLetter {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  filename      String
  key           String
  sentAt        DateTime    @default(now())

  @@map("offerLetter")
}

model FundingOption {
  id          String   @id @default(cuid())
  name        String   @unique
  provider    String
  type        String
  description String?
  eligibility String?
  benefits    String?
  coversTuition Boolean @default(false)
  coversAccommodation Boolean @default(false)
  coversBooks Boolean @default(false)
  coversAllowance Boolean @default(false)
  amountMin   Int?
  amountMax   Int?
  deadline    DateTime?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fundingOption")
}

/// Money is stored in cents as an integer so rounding never drifts, and the API converts
/// to rands at the edge. category is a short learner-chosen label (food, transport, rent),
/// not free text embedded in prompts.
model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  amountCents Int
  description String?
  spentAt     DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, spentAt])
  @@map("expense")
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  amountCents Int
  period      String   @default("MONTHLY")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, period])
  @@index([userId])
  @@map("budget")
}

/// A weekly plan the learner approves before it appears on their calendar. `blocks` is a
/// JSON array of { day, task, startTime?, durationMinutes? } validated before it is stored.
model StudyPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  approved  Boolean  @default(false)
  blocks    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("studyPlan")
}

/// A group clinic session (for example "NSFAS application help"). capacity is the number of
/// learners who can book it; the API refuses a booking once it is full.
model ClinicSlot {
  id        String    @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  topic     String
  capacity  Int       @default(1)
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@unique([startsAt, topic])
  @@index([startsAt])
  @@map("clinicSlot")
}

model Booking {
  id        String     @id @default(cuid())
  slotId    String
  slot      ClinicSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String     @default("CONFIRMED")
  createdAt DateTime   @default(now())

  @@unique([slotId, userId])
  @@index([userId])
  @@map("booking")
}

model Community {
  id          String    @id @default(cuid())
  name        String    @unique
  field       String?
  description String?
  createdById String?
  createdAt   DateTime  @default(now())
  messages    Message[]

  @@map("community")
}

model Message {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())

  @@index([communityId, createdAt])
  @@index([userId])
  @@map("message")
}

/// A learner's report of a message, user or community. Stores no copy of the reported
/// content: the moderator reads the original record, and the report itself stays small.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  status     String   @default("SUBMITTED")
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@map("report")
}
