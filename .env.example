# iskole environment template.
# Copy to .env and fill in real values. .env is gitignored; this file is committed.
# Rule: every secret here is per-environment. Never reuse a key across dev and prod.

# --- Database (docker compose: pnpm dev:db) ---
DATABASE_URL=postgresql://iskole:iskole@localhost:5434/iskole?schema=public

# --- API ---
# Port 8004 because another project on the dev machine already runs on 4000.
API_PORT=8004
NODE_ENV=development
# Public origin of the web app, used for CSRF (Origin header) checks and links in emails.
APP_URL=http://localhost:3004
# Internal origin of the API, used by Next rewrites and server-side code.
API_INTERNAL_URL=http://localhost:8004
# Number of reverse proxies in front of the API. The local setup always goes through the
# Next.js rewrite, so 1 is correct here. Use 0 only when the API is exposed directly, and
# increase only to match real load-balancer hops. Ignoring this makes every learner share the
# proxy's IP (and one rate-limit bucket); setting it too high lets clients spoof their IP.
TRUST_PROXY_HOPS=1

# --- better-auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes-base64
# Public origin of the API for better-auth URL construction.
BETTER_AUTH_URL=http://localhost:8004

# --- ID number encryption (AES-256-GCM) ---
# Generate with: openssl rand -base64 32. Must be different per environment.
ID_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64

# --- Signed URL secret (short-lived document and offer downloads) ---
# Generate with: openssl rand -base64 32. Different per environment.
SIGNING_SECRET=replace-me-with-32-random-bytes-base64

# --- AI (OpenRouter). Server side only. Never exposed to the browser. ---
# Get a key at https://openrouter.ai/keys. The key is per environment; never reuse one.
# Requests set `provider.zdr` and `provider.data_collection: 'deny'`, so only endpoints that
# retain nothing are used. Keep that behaviour on; it is a POPIA control, not an optimisation.
OPENROUTER_API_KEY=
# Cheap, fast primary model. Structured-output capable, which matching and study plans need.
# Every model below must have ZDR and structured-output endpoints. If one does not, the AI
# call fails closed and the deterministic result is shown instead.
OPENROUTER_MODEL=inception/mercury-3
# Comma-separated fallback models, tried in order if the primary errors or is rate limited.
# OpenRouter's `models` array does the failover server side. Keep the list short.
OPENROUTER_FALLBACK_MODELS=anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5
# Hard ceiling on a single AI call so a hung provider cannot hold a request open.
OPENROUTER_TIMEOUT_MS=20000
# Per-account daily cap on AI calls, independent of the per-IP route limiter.
AI_DAILY_CALL_LIMIT=100

# --- Email (Mailpit locally; a transactional provider when deployed) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=iskole@localhost.test

# --- Uploads (stored outside the web root, served only via signed URLs) ---
UPLOAD_DIR=var/uploads
